<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>개인정보 보호 용어 퀴즈 대시보드</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Pretendard:wght@400;600;700&display=swap');
        body {
            font-family: 'Pretendard', sans-serif;
            background-color: #f8fafc;
        }
        .quiz-card {
            transition: all 0.3s ease;
        }
        .correct {
            border-color: #10b981;
            background-color: #ecfdf5;
        }
        .incorrect {
            border-color: #ef4444;
            background-color: #fef2f2;
        }
    </style>
</head>
<body class="p-4 md:p-8">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <header class="mb-8 text-center">
            <h1 class="text-3xl font-bold text-slate-800 mb-2">개인정보 보호 용어 마스터</h1>
            <p class="text-slate-600">제시된 정의를 읽고 올바른 용어를 입력하세요.</p>
            <div class="mt-4 flex justify-center gap-4">
                <div class="bg-white px-4 py-2 rounded-full shadow-sm border border-slate-200">
                    <span class="text-sm text-slate-500 font-medium">진행도:</span>
                    <span id="progress-text" class="text-sm font-bold text-blue-600 ml-1">0 / 14</span>
                </div>
                <div class="bg-white px-4 py-2 rounded-full shadow-sm border border-slate-200">
                    <span class="text-sm text-slate-500 font-medium">정답률:</span>
                    <span id="score-text" class="text-sm font-bold text-green-600 ml-1">0%</span>
                </div>
            </div>
        </header>

        <!-- Quiz Container -->
        <div id="quiz-container" class="space-y-6">
            <!-- Questions will be injected here -->
        </div>

        <!-- Result Section -->
        <div id="result-section" class="mt-12 p-8 bg-white rounded-2xl shadow-lg border border-slate-200 text-center hidden">
            <h2 class="text-2xl font-bold text-slate-800 mb-4">학습 완료!</h2>
            <p id="final-score" class="text-lg text-slate-600 mb-6 font-medium"></p>
            <button onclick="window.location.reload()" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-xl transition-colors">
                다시 풀기
            </button>
        </div>
    </div>

    <script>
        const quizData = [
            { id: 1, answer: "개인정보처리시스템", hint: "데이터베이스시스템 등 체계적으로 구성한 시스템", text: "개인정보를 처리할 수 있도록 체계적으로 구성한 시스템을 말한다." },
            { id: 2, answer: "이용자", hint: "정보통신서비스를 이용하는 자", text: "「정보통신망 이용촉진 및 정보보호 등에 관한 법률」 제2조제1항제4호에 따른 정보통신서비스 제공자가 제공하는 정보통신서비스를 이용하는 자를 말한다." },
            { id: 3, answer: "접속기록", hint: "수행한 업무내역을 전자적으로 기록한 것", text: "개인정보처리시스템에 접속하는 자가 개인정보처리시스템에 접속하여 수행한 업무내역에 대하여 식별자, 접속일시, 접속지 정보, 처리한 정보주체 정보, 수행업무 등을 전자적으로 기록한 것을 말한다." },
            { id: 4, answer: "정보통신망", hint: "전기통신설비와 컴퓨터 기술을 활용한 체계", text: "「정보통신망 이용촉진 및 정보보호 등에 관한 법률」 제2조제1항제1호의 「전기통신사업법」 제2조제2호에 따른 전기통신설비를 이용하거나 전기통신설비를 활용하여 정보를 수집·가공·저장·검색·송신 또는 수신하는 정보통신체계를 말한다." },
            { id: 5, answer: "P2P", hint: "서버 없이 개인과 개인이 직접 연결", text: "정보통신망을 통해 서버의 도움 없이 개인과 개인이 직접 연결되어 파일을 공유하는 것을 말한다." },
            { id: 6, answer: "공유설정", hint: "타인이 조회·변경·복사 등을 할 수 있도록 설정", text: "컴퓨터 소유자의 파일을 타인이 조회·변경·복사 등을 할 수 있도록 설정하는 것을 말한다." },
            { id: 7, answer: "모바일 기기", hint: "스마트폰, 태블릿 등 휴대용 기기", text: "무선망을 이용할 수 있는 스마트폰, 태블릿 컴퓨터 등 개인정보 처리에 이용되는 휴대용 기기를 말한다." },
            { id: 8, answer: "비밀번호", hint: "식별자와 함께 입력하는 고유의 문자열", text: "정보주체 및 개인정보취급자 등이 시스템에 접속할 때 식별자와 함께 입력하여 정당한 권한을 가진 자라는 것을 식별할 수 있도록 전달해야 하는 고유의 문자열을 말한다." },
            { id: 9, answer: "생체정보", hint: "지문, 얼굴, 홍채 등 신체적 특징 정보", text: "지문, 얼굴, 홍채, 정맥, 음성, 필적 등 개인의 신체적, 생리적, 행동적 특징에 관한 정보로서 특정 개인을 인증·식별하기 위해 처리되는 정보를 말한다." },
            { id: 10, answer: "생체인식정보", hint: "인증 또는 식별 목적으로 처리되는 생체정보", text: "생체정보 중 특정 개인을 인증 또는 식별할 목적으로 일정한 기술적 수단을 통해 처리되는 정보를 말한다." },
            { id: 11, answer: "인증정보", hint: "신원을 검증하는 데 사용되는 정보", text: "개인정보처리시스템 또는 정보통신망을 관리하는 시스템 등에 접속을 요청하는 자의 신원을 검증하는데 사용되는 정보를 말한다." },
            { id: 12, answer: "내부망", hint: "인터넷 구간에서의 접근이 통제되는 구간", text: "인터넷망 차단, 접근 통제시스템 등에 의해 인터넷 구간에서의 접근이 통제 또는 차단되는 구간을 말한다." },
            { id: 13, answer: "위험분석", hint: "위험요소를 식별·평가하고 방안을 분석하는 행위", text: "개인정보 유출에 영향을 미칠 수 있는 다양한 위험요소를 식별·평가하고 해당 위험요소를 적절하게 통제할 수 있는 방안 마련을 위한 종합적으로 분석하는 행위를 말한다." },
            { id: 14, answer: "보조저장매체", hint: "USB, 외장하드 등 분리 가능한 매체", text: "이동형 하드디스크(HDD), 유에스비(USB)메모리 등 자료를 저장할 수 있는 매체로서 개인정보처리시스템 또는 개인용 컴퓨터 등과 쉽게 연결·분리할 수 있는 저장매체를 말한다." }
        ];

        let userAnswers = new Array(quizData.length).fill(null);

        function renderQuiz() {
            const container = document.getElementById('quiz-container');
            container.innerHTML = quizData.map((item, index) => `
                <div id="card-${index}" class="quiz-card bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                    <div class="flex items-start justify-between mb-4">
                        <span class="inline-flex items-center justify-center bg-slate-100 text-slate-600 font-bold w-8 h-8 rounded-lg text-sm mr-3">
                            ${item.id}
                        </span>
                        <button onclick="showHint(${index})" class="text-xs text-blue-500 font-semibold hover:underline">힌트 보기</button>
                    </div>
                    <p class="text-slate-700 leading-relaxed mb-6">
                        " <span id="answer-display-${index}" class="font-bold text-blue-600 bg-blue-50 px-2 py-1 rounded">OOO</span> " <span class="text-slate-500">${item.text}</span>
                    </p>
                    <div class="flex gap-2">
                        <input type="text" 
                               id="input-${index}" 
                               placeholder="정답을 입력하세요" 
                               class="flex-1 px-4 py-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all"
                               onkeypress="handleKeyPress(event, ${index})">
                        <button onclick="checkAnswer(${index})" class="bg-slate-800 text-white px-6 py-3 rounded-xl font-bold hover:bg-slate-700 transition-colors">확인</button>
                    </div>
                    <p id="hint-text-${index}" class="text-xs text-slate-400 mt-3 hidden">힌트: ${item.hint}</p>
                </div>
            `).join('');
        }

        function showHint(index) {
            document.getElementById(`hint-text-${index}`).classList.toggle('hidden');
        }

        function handleKeyPress(event, index) {
            if (event.key === 'Enter') {
                checkAnswer(index);
            }
        }

        function checkAnswer(index) {
            const input = document.getElementById(`input-${index}`);
            const card = document.getElementById(`card-${index}`);
            const display = document.getElementById(`answer-display-${index}`);
            const value = input.value.trim();

            if (!value) return;

            // 정답 체크 (공백 제거 후 비교)
            const isCorrect = value.replace(/\s/g, '') === quizData[index].answer.replace(/\s/g, '');

            if (isCorrect) {
                card.classList.remove('incorrect');
                card.classList.add('correct');
                display.innerText = quizData[index].answer;
                input.disabled = true;
                userAnswers[index] = true;
            } else {
                card.classList.add('incorrect');
                userAnswers[index] = false;
                setTimeout(() => card.classList.remove('incorrect'), 500);
            }

            updateStats();
        }

        function updateStats() {
            const answeredCount = userAnswers.filter(a => a === true).length;
            const progressPercent = Math.round((answeredCount / quizData.length) * 100);
            
            document.getElementById('progress-text').innerText = `${answeredCount} / ${quizData.length}`;
            document.getElementById('score-text').innerText = `${progressPercent}%`;

            if (answeredCount === quizData.length) {
                showFinalResult();
            }
        }

        function showFinalResult() {
            const resultSection = document.getElementById('result-section');
            const finalScore = document.getElementById('final-score');
            resultSection.classList.remove('hidden');
            finalScore.innerText = `총 ${quizData.length}개의 필수 개인정보 용어를 모두 마스터하셨습니다!`;
            window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
        }

        window.onload = renderQuiz;
    </script>
</body>
</html>
